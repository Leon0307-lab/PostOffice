# ---------------------------------------------------------------
# PostOffice - Umgebungsvariablen
# Kopiere diese Datei nach .env.local (lokal/Codespaces) bzw. trage
# die Werte in Vercel unter Settings > Environment Variables ein.
# ---------------------------------------------------------------

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# NUR SERVER! Niemals mit NEXT_PUBLIC_ versehen, niemals committen.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Geheimer Zufallswert (mind. 32 Zeichen) zum Hashen der Abholcodes (HMAC).
# Erzeugen z. B. mit: openssl rand -base64 48
PICKUP_CODE_PEPPER=bitte-durch-langen-zufallswert-ersetzen

# Öffentliche Basis-URL der App (für Links/QR-Codes), ohne Slash am Ende.
NEXT_PUBLIC_APP_URL=http://localhost:3000
